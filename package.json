{
  "name": "aldimobilya",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "pnpm --parallel --filter web --filter admin dev",
    "dev:web": "pnpm --filter web dev",
    "dev:admin": "pnpm --filter admin dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter admin test",
    "typecheck": "pnpm --filter web exec tsc --project tsconfig.json --noEmit && pnpm --filter admin exec tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@neon/config": "^1.4.2",
    "@neon/env": "^1.3.2"
  },
  "devDependencies": {
    "puppeteer-core": "^25.11.0"
  }
}
