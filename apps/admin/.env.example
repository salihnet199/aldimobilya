# Database (Neon/Postgres) — shared with packages/db
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# Auth.js (NextAuth v5) — generate with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-string"

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Public (customer-facing) site origin — used by "Siteyi Görüntüle" and every
# "Sitede Gör" link. This is NOT the admin origin; the admin app runs on its own
# port. Falls back to https://aldimobilya.com when unset.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
