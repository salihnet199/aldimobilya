# Admin app. Copy to .env and fill in.
# Root .env.example documents every variable the monorepo reads.

# Database (Neon/Postgres) — shared with packages/db
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# Auth.js (NextAuth v5) — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
AUTH_SECRET="replace-with-a-long-random-string"
# Public origin of the admin app; also a trusted origin for CSRF checks.
NEXTAUTH_URL="http://localhost:3001"
AUTH_URL="http://localhost:3001"
# Extra trusted origins behind a proxy (comma separated).
ADMIN_TRUSTED_ORIGINS=""

# Login rate limiting
ADMIN_RATE_LIMIT_SALT="replace-with-a-random-string"
# "true"/"1" only behind a trusted proxy, so X-Forwarded-For is honored.
ADMIN_TRUST_PROXY=""

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Signed upload presets — without them direct uploads are disabled and the UI
# falls back to the slower server-validated route.
CLOUDINARY_IMAGE_UPLOAD_PRESET="aldimobilya_image"
CLOUDINARY_VIDEO_UPLOAD_PRESET="aldimobilya_video"

# Public (customer-facing) site origin — used by "view on site" links.
# This is NOT the admin origin. Falls back to https://aldimobilya.com when unset.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
