# Web app (customer-facing). Copy to .env and fill in.
# Root .env.example documents every variable the monorepo reads.

# Database (Neon/Postgres) — shared with packages/db
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Canonical public origin (SEO, sitemap, JSON-LD). Must match the deployed domain.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Initial WhatsApp number shown before any DB settings row exists.
# Leave empty to fall back to the internal contact page instead of a fake link.
NEXT_PUBLIC_WHATSAPP_NUMBER=""
