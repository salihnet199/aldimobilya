# =============================================================================
# ALDi Mobilya — Environment Variables
# =============================================================================
# Copy this file to .env.local (root), apps/web/.env and apps/admin/.env,
# then fill in the values. Never commit real secrets.
#
# Apps load their own .env file; packages/db loads packages/db/.env.
# The same DATABASE_URL must be present wherever Prisma is used.

# -----------------------------------------------------------------------------
# DATABASE (Neon — Postgres)
# -----------------------------------------------------------------------------
# Pooled connection (PgBouncer) for the app, direct connection for migrations.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# -----------------------------------------------------------------------------
# AUTH (NextAuth v5 — admin app only)
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-with-openssl-rand-base64-32"
# Public origin of the admin app. Also read as a trusted origin for CSRF checks.
NEXTAUTH_URL="http://localhost:3001"
AUTH_URL="http://localhost:3001"
# Extra trusted origins for same-origin checks behind a proxy (comma separated).
ADMIN_TRUSTED_ORIGINS=""

# -----------------------------------------------------------------------------
# LOGIN RATE LIMITING (admin app)
# -----------------------------------------------------------------------------
# Salt for the in-memory account digest. Any random string; never logged.
ADMIN_RATE_LIMIT_SALT="change-me"
# Set to "true"/"1" only behind a trusted proxy, so X-Forwarded-For is honored.
ADMIN_TRUST_PROXY=""

# -----------------------------------------------------------------------------
# CLOUDINARY (media — web + admin)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
# Signed upload presets (create them in the Cloudinary dashboard). They carry
# the provider-side max_file_size; direct uploads are disabled without them
# and the UI falls back to the slower server-validated route.
CLOUDINARY_IMAGE_UPLOAD_PRESET="aldimobilya_image"
CLOUDINARY_VIDEO_UPLOAD_PRESET="aldimobilya_video"

# -----------------------------------------------------------------------------
# SITE (web + admin)
# -----------------------------------------------------------------------------
# Canonical public origin. Used for SEO, sitemap, JSON-LD and admin "view on
# site" links. Must match the deployed domain in production.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Initial WhatsApp number shown before any DB settings row exists.
NEXT_PUBLIC_WHATSAPP_NUMBER=""
